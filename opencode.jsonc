{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3.5-lightning-free",
  "small_model": "opencode/deepseek-v4-flash-free",
  "instructions": [
    "AGENTS.md",
    "docs/ESTADO.md",
    ".claude/memory/MEMORY.md"
  ],
  "mcp": {
    "boundary-validator": {
      "type": "local",
      "command": [
        "python3",
        "tools/boundary_validator/validator.py"
      ],
      "cwd": "."
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      // Python execution: block inline, allowlist committed scripts
      "python3 -c *": "deny",
      "python3 -m *": "deny",
      "python3 tools/*": "allow",
      "python3 tools/*.py": "allow",
      "python3 tools/audit/*": "allow",
      "python3 tools/hooks/*": "allow",
      "python3 tools/boundary_validator/validator.py": "allow",
      // pytest and read-only commands, allowed after the catch-all and rm (AGENTS 7.1)
      "pytest": "allow",
      "pytest *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "df": "allow",
      "df *": "allow",
      "echo *": "allow",
      "sed -n *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "diff *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "cmp *": "allow",
      "date": "allow",
      "date +*": "allow",
      // Safe read-only Git inspection
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git merge-base *": "allow",
      "git rev-list *": "allow",
      "git for-each-ref *": "allow",
      "git add *": "ask",
      // Branch management and GitHub CLI interaction
      "git checkout -b *": "ask",
      "gh issue *": "ask",
      "gh pr *": "ask",
      // Git mutations and advanced management
      "git commit *": "ask",
      "git checkout *": "ask",
      "git branch *": "ask",
      "git stash *": "ask",
      "git tag *": "ask",
      "git remote *": "ask",
      "git fetch *": "ask",
      "git pull *": "ask",
      "git push *": "ask",
      "git config *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git submodule *": "ask",
      "git rm *": "ask",
      "git worktree *": "ask"
    },
    // The validate_proposal tool of the MCP server boundary-validator, under the name OpenCode gives it:
    // server and tool joined by an underscore. The name has not been checked by running OpenCode;
    // if it does not match, OpenCode keeps asking.
    "boundary-validator_validate_proposal": "allow"
  },
  "enabled_providers": [
    "opencode"
  ],
  "experimental": {
    "mcp_timeout": 30000
  }
}